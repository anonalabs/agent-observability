# Recommended: don't hand-edit this. Run `agentobs config-alerts` instead --
# it prompts for the webhook URL and thresholds and generates both this file
# and rules.yaml for you (see docs/alerting.md).
#
# Manual alternative, if you'd rather not use the CLI:
#   cp contactpoints.yaml.example contactpoints.yaml
#   # edit the url below
#   docker compose restart grafana
apiVersion: 1

contactPoints:
  - orgId: 1
    name: agentobs-webhook
    receivers:
      - uid: agentobs-webhook-1
        type: slack # use "slack" for Slack or Discord's /slack-compatible webhook URL, "webhook" for a generic JSON POST (PagerDuty, custom receivers, etc.)
        settings:
          url: "https://REPLACE_ME.example.com/webhook"

policies:
  - orgId: 1
    receiver: agentobs-webhook
